{
  "name": "@msafe/mpay-sdk-sui",
  "version": "2.0.0",
  "author": "MSafe Team <admin@m-safe.io>",
  "repository": "git@github.com:Momentum-Safe/mpay-sdk-sui.git",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "peerDependencies": {
    "@mysten/sui": "^2.0.0"
  },
  "dependencies": {
    "exponential-backoff": "^3.1.1",
    "luxon": "^3.4.3",
    "nanoid": "3"
  },
  "devDependencies": {
    "axios": "^1.5.0",
    "child_process": "^1.0.2",
    "fs": "^0.0.1-security",
    "tsconfig-paths": "^4.2.0",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@mysten/sui": "^2.20.0",
    "@types/jest": "^29.5.4",
    "@types/luxon": "^3.3.2",
    "@types/node": "^20.6.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.5.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.48.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsup": "^7.2.0",
    "typescript": "^5.2.2"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "description": "MPay SDK on SUI",
  "license": "MIT",
  "private": false,
  "scripts": {
    "clean": "rm -rf ./dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --fix",
    "build": "yarn clean && yarn _build:node",
    "_build:node": "tsup --format cjs,esm --dts",
    "localnet": "sui-test-validator 2>/dev/null",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --verbose",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest --verbose test/unit/utils test/unit/stream/metadata.test.ts test/unit/stream/helper.test.ts test/unit/stream/client.test.ts test/unit/utils/env.test.ts test/unit/sui/iter.test.ts",
    "test:chain": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --verbose test/mpay.test.ts test/unit/stream/Stream.test.ts test/unit/stream/StreamGroup.test.ts test/unit/transaction/CreateStreamHelper.test.ts test/unit/transaction/decoder.test.ts test/unit/sui/coin.test.ts test/unit/stream/query.test.ts",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --verbose test/mpay.test.ts",
    "integration": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand test/mpay.test.ts",
    "playground": "jest playground.test.ts",
    "prerelease": "yarn build && ./scripts/publish.sh"
  },
  "types": "./dist/index.d.ts"
}
